    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@orbit/prettier-config": "^1.0.0",
    "prettier": "^2.2.1",
    "snowpack": "^3.0.11",
    "testem": "^3.2.0"
  },
  "prettier": "@orbit/prettier-config",
  "volta": {
    "node": "^18.20.8",
    "pnpm": "10.16.1"
  }
}
