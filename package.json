{
  "name": "@orbit/orbit",
  "private": true,
  "description": "Core library for Orbit - a flexible data access and synchronization layer.",
  "contributors": [
    "Dan Gebhardt <dan@cerebris.com>"
  ],
  "keywords": [
    "orbit",
    "orbit.js",
    "data",
    "synchronization"
