{
  "name": "@orbit/integration-tests",
  "private": true,
  "version": "0.17.2",
  "description": "Integration tests for core Orbit packages.",
  "contributors": [
    "Dan Gebhardt <dan@cerebris.com>"
  ],
  "repository": "https://github.com/orbitjs/orbit",
  "license": "MIT",
  "scripts": {
    "compile": "tsc",
    "clean": "git clean -x -f",
    "lint": "eslint . --ext .ts",
    "start": "node ../build dev && snowpack dev",
    "test": "node ../build ci && snowpack build && testem ci"
  },
  "dependencies": {
    "@orbit/coordinator": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/data": "workspace:*",
    "@orbit/immutable": "workspace:*",
    "@orbit/indexeddb": "workspace:*",
    "@orbit/indexeddb-bucket": "workspace:*",
    "@orbit/jsonapi": "workspace:*",
    "@orbit/local-storage": "workspace:*",
    "@orbit/local-storage-bucket": "workspace:*",
    "@orbit/memory": "workspace:*",
    "@orbit/record-cache": "workspace:*",
    "@orbit/records": "workspace:*",
    "@orbit/serializers": "workspace:*",
    "@orbit/utils": "workspace:*"
  },
  "devDependencies": {
    "@orbit/build": "workspace:*",
    "@types/qunit": "^2.11.3",
    "@types/sinon": "^9.0.0",
    "qunit": "^2.14.0",
    "sinon": "^9.0.2",
    "typescript": "^4.5.4",
    "whatwg-fetch": "^3.0.0"
  },
  "prettier": "@orbit/prettier-config"
}
